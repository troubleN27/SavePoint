generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon). DATABASE_URL — через пул соединений (для приложения),
// DATABASE_URL_UNPOOLED — прямое подключение (для миграций Prisma CLI)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Статусы и тарифы хранятся строками и валидируются в коде (src/lib/constants.ts)

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  username     String   @unique
  plan         String   @default("FREE") // FREE | PRO
  isPublic     Boolean  @default(false)
  bio          String?
  createdAt    DateTime @default(now())

  // Подписка Stripe; plan выше — производное от её статуса (см. src/lib/billing.ts)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  subscriptionInterval String? // month | year
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  games           UserGame[]
  shelves         Shelf[]
  recommendations RecommendationCache?
}

model Game {
  id          String   @id @default(cuid())
  rawgId      Int?     @unique
  slug        String   @unique
  title       String
  coverUrl    String?
  genres      String   @default("[]") // JSON string[]
  platforms   String   @default("[]") // JSON string[]
  releaseYear Int?
  createdAt   DateTime @default(now())

  entries UserGame[]

  @@index([title])
}

model UserGame {
  id             String    @id @default(cuid())
  userId         String
  gameId         String
  status         String    // PLAYING | COMPLETED | WANT | DROPPED
  rating         Int?
  review         String?   @db.Text
  hoursPlayed    Float?
  platformPlayed String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  shelfItems ShelfItem[]

  @@unique([userId, gameId])
  @@index([userId, status])
}

model Shelf {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShelfItem[]
}

model ShelfItem {
  id         String   @id @default(cuid())
  shelfId    String
  userGameId String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  shelf    Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  userGame UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  @@unique([shelfId, userGameId])
}

model RecommendationCache {
  id        String   @id @default(cuid())
  userId    String   @unique
  source    String   // ai | algo
  payload   String   @db.Text // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
