# Neon Postgres (https://console.neon.tech → Connect).
# Пул соединений (в хосте есть "-pooler") — для приложения:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Прямое подключение (без "-pooler") — для миграций Prisma:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# openssl rand -base64 32
AUTH_SECRET="change-me"

# Stripe (https://dashboard.stripe.com/test/apikeys). Без ключа оплата отключена.
STRIPE_SECRET_KEY="sk_test_..."
# Секрет вебхука: npm run stripe:setup -- --webhook https://<домен>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# Необязательно: https://rawg.io/apidocs — без ключа поиск идёт по встроенному каталогу
RAWG_API_KEY=""

# Необязательно: AI-рекомендации. Gemini в приоритете, ключ: https://aistudio.google.com/apikey
# Без ключей рекомендации строятся алгоритмом по жанрам
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Альтернатива Gemini: Claude (используется, если GEMINI_API_KEY пуст)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
